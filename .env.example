# Copy to .env for local development. Never commit .env.

# Optional: server-side Finnhub key for real-time quotes (yfinance is the fallback).
FINNHUB_API_KEY=

# "lexicon" (default, no extra deps) or "finbert" (pip install -r requirements-nlp.txt)
GMP_SENTIMENT_BACKEND=lexicon

# Comma-separated origins allowed to call the API.
GMP_CORS_ORIGINS=http://localhost:5173,https://globalmarketpredictor.onrender.com

# Offline mode: read prices from a folder of yfinance CSVs instead of the network.
# GMP_PRICE_CSV_DIR=./data/prices
